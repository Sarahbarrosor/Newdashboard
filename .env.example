# ====== DATABASE ======
# These five are auto-populated by Vercel when you connect a Postgres store.
# Locally, copy the values from the Vercel dashboard → Storage → your DB → .env.local tab.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_HOST=

# ====== AUTH ======
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# In production this is your Vercel URL, e.g. https://newdashboard.vercel.app
# Locally: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ====== EMAIL (Resend) ======
RESEND_API_KEY=
# Until you verify a domain, use onboarding@resend.dev
RESEND_FROM=onboarding@resend.dev

# ====== AI (Anthropic) ======
ANTHROPIC_API_KEY=

# ====== KATANA MRP ======
# Optional — leave blank until you have a Katana account.
# Sync worker will skip when empty.
KATANA_API_KEY=
KATANA_WEBHOOK_SECRET=

# ====== QUICKBOOKS ======
# Optional — leave blank until you register a QuickBooks developer app.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# ====== ENCRYPTION ======
# 32-byte base64 string. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=
